---
import { ArrowRight, FlaskConical, Settings, Beaker, PackageCheck } from 'lucide-react';
import { MoleculeMotif } from './MoleculeMotif';

const features = [
  { icon: Settings, label: 'Toll Manufacturing' },
  { icon: PackageCheck, label: 'Contract Manufacturing' },
  { icon: Beaker, label: 'Custom Formulations' },
  { icon: FlaskConical, label: 'Blending & Masterbatches' },
];
---

<section class="bg-white border-b border-slate-200 relative overflow-hidden">
  <MoleculeMotif variant="orbits" intensity="prominent" position="center" animated={true} />
  <div class="max-w-7xl mx-auto px-4 md:px-10 py-24 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div data-animate="left" class="relative z-20">
        <h2 class="text-brand-orange font-bold tracking-widest uppercase text-xs mb-4">
          Manufacturing Services
        </h2>
        <h3 class="text-4xl md:text-5xl font-black text-brand-dark leading-tight tracking-tight mb-6">
          YOUR DEDICATED<br class="hidden md:block" /> MANUFACTURING PARTNER
        </h3>
        <p class="text-base text-text-secondary leading-relaxed mb-8 max-w-lg">
          State-of-the-art facilities equipped with cutting-edge technology. From custom formulations to large-scale toll manufacturing, we deliver premium-quality chemical products with full regulatory compliance.
        </p>
        <a
          href="/manufacturing"
          class="inline-flex items-center gap-2 bg-brand-dark hover:bg-black text-white px-8 py-4 text-xs font-bold uppercase tracking-widest transition-colors group"
        >
          Explore Manufacturing
          <ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" />
        </a>
      </div>

      <div data-animate="right" data-delay="200" class="grid grid-cols-2 gap-4 relative z-20">
        {features.map((f, i) => (
          <div
            class="bg-slate-50 border border-slate-200 p-6 group hover:border-brand-orange/30 hover:bg-brand-orange/5 transition-colors"
          >
            <f.icon className="w-8 h-8 text-brand-orange mb-4" />
            <h4 class="text-sm font-bold text-brand-dark">{f.label}</h4>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
