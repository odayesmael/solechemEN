---
import Layout from '../layouts/Layout.astro';
import { Hero } from '../components/Hero';
import Stats from '../components/Stats.astro';
import { IndustriesBlock } from '../components/IndustriesBlock';
import About from '../components/About.astro';
import { CategoriesGrid } from '../components/CategoriesGrid';
import { ProductSearch } from '../components/ProductSearch';
import Values from '../components/Values.astro';
import TrustedBy from '../components/TrustedBy.astro';
import ManufacturingTeaser from '../components/ManufacturingTeaser.astro';
import { CTA } from '../components/CTA';
import { organizationSchema, buildWebsiteSchema, buildBreadcrumbSchema, buildCanonicalUrl } from '../utils/seo';

const breadcrumb = buildBreadcrumbSchema([
  { name: 'Home', url: buildCanonicalUrl('/') },
]);
---

<Layout
  title="SoleChem | Global Chemical Distributor & Manufacturer | 4,480+ Products"
  description="Global B2B chemical distributor supplying 4,480+ high-purity products to 50+ countries worldwide. ISO 9001 & GMP+ certified. Polyurethane systems, adhesives, paints, and industrial raw materials."
  keywords="global chemical distributor, chemical manufacturer, B2B chemicals, industrial chemicals, international chemical supplier, ISO 9001, GMP+"
  canonical={buildCanonicalUrl('/')}
  ogImage={buildCanonicalUrl('/og-home.webp')}
  jsonLd={[organizationSchema, buildWebsiteSchema(), breadcrumb]}
>
  <Hero client:load />
  <Stats />
  <IndustriesBlock client:load />
  <About />
  <CategoriesGrid client:load />
  <ProductSearch client:load />
  <Values />
  <TrustedBy />
  <ManufacturingTeaser />
  <CTA client:load />
</Layout>
