---
import Layout from '../layouts/Layout.astro';
import { FAQ } from '../views/FAQ';
import { buildCanonicalUrl, buildBreadcrumbSchema, buildFAQSchema } from '../utils/seo';
import { getAllFAQItems } from '../data/faq';

const breadcrumb = buildBreadcrumbSchema([
  { name: 'Home', url: buildCanonicalUrl('/') },
  { name: 'FAQ', url: buildCanonicalUrl('/faq') },
]);

const allFaqs = getAllFAQItems();
const faqSchema = buildFAQSchema(allFaqs.map(f => ({ question: f.question, answer: f.answer })));
---

<Layout
  title="Frequently Asked Questions | SoleChem"
  description="Find answers to common questions about SoleChem's products, ordering, shipping, quality certifications, and manufacturing services."
  canonical={buildCanonicalUrl('/faq')}
  jsonLd={[breadcrumb, faqSchema]}
>
  <FAQ client:load />
</Layout>
